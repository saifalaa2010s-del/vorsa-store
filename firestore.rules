rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /preorders/{orderId} {
      // Visitors can submit a valid preorder, but cannot read, edit, or delete records.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'email', 'game', 'source', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'name', 'email', 'game', 'source', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 40 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        request.resource.data.game == 'VORSA CITY' &&
        request.resource.data.source == 'official-website' &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}
